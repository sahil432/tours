{#
/**
 * @file
 * Default theme implementation to present a bookable calendar opening entity.
 *
 * This template is used when viewing a registered bookable calendar opening's page,
 * e.g., /admin/content/bookable-calendar/booking-calendar-opening)/123. 123 being the bookable calendar opening's ID.
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 *   print a subset such as 'content.title'.
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_bookable_calendar_opening()
 */
#}
{#
/**
 * Custom table layout for Bookable Calendar Opening (Admin view)
 */
#}

<table class="bookable-opening-table">
  <thead>
    <tr>
      <th>Reservation Type</th>
      <th>Date</th>
      <th>Tour Start</th>
      <th>Status</th>
      <th>Slots</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <tr>

      {# Bookable calendar name #}
      <td>
        {{ content.bookable_calendar }}
      </td>

      <td>
        {{ content.date }}
      </td>

      {# Tour selection #}
      <td>
        {{ content.field_tour_selection }}
      </td>

      {# Status #}
      <td>
        {{ content.status }}
      </td>

      {# Book button #}
      <td>
        {% if content.status['#items'].value == 1 %}
          {{ content.booking_instance }}
        {% else %}
          <em>—</em>
        {% endif %}
      </td>
      <td>
        {% if content.status['#items'].value == 1 %}
          {% if slots_available > 0 %}
            <a href="{{ path('entity.booking.add_form') ~ '?bookable_calendar_opening=' ~ content['#bookable_calendar_opening'].id() }}"
              class="button button--primary">
              Book Now
            </a>
          {% else %}
            <em>No Slots Available</em>
          {% endif %}

        {% else %}
          <em>—</em>
        {% endif %}
      </td>
    </tr>
  </tbody>
</table>
